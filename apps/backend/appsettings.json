{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=tcp:{your_server}.database.windows.net,1433;Initial Catalog={your_database};User Id={your_username};Password={your_password};Encrypt=true;Connection Timeout=30;Authentication=\"Active Directory Password\";"
  }
}
