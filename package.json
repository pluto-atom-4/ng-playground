{
  "name": "ng-playground",
  "version": "1.0.0",
  "description": "Full-stack Angular + .NET 9 monorepo",
  "private": true,
  "scripts": {
    "frontend:install": "pnpm -F frontend install",
    "frontend:dev": "pnpm -F frontend start",
    "frontend:build": "pnpm -F frontend build",
    "frontend:lint": "pnpm -F frontend lint",
    "frontend:test": "pnpm -F frontend test",
    "backend:restore": "cd apps/backend && dotnet restore",
    "backend:build": "cd apps/backend && dotnet build",
    "backend:dev": "cd apps/backend && dotnet run",
    "backend:test": "cd apps/backend && dotnet test",
    "install": "pnpm install && pnpm backend:restore"
  }
}
